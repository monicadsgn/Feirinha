{
  "name": "feirinha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "node scripts/copy-ocr.mjs && npm run build:api && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:api": "rolldown server/casa.ts --format esm --platform node --file api/casa.js --banner '// Gerado por `npm run build:api` a partir de server/casa.ts. Não edite à mão.'"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tesseract.js-data/por": "^1.0.0",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
